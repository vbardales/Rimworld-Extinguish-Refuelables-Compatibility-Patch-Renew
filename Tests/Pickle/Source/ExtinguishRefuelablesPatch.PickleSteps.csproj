<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Steps only this mod's suite needs: the switch, the fire overlay class and the rotation of a
    spawned building, none of which Pickle's own steps reach. Only Pickle loads this assembly, from
    the test companion, never from Mod/.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>ExtinguishRefuelablesPatch.PickleSteps</AssemblyName>
    <RootNamespace>ExtinguishRefuelablesPatch.PickleSteps</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <OutputPath>..\Mod\Pickle\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.*-*" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="RimWorks.Pickle.Ref" Version="4.*" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

</Project>
